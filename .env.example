# --- Supabase (produção) ---
# Migrations/seed: Direct connection (porta 5432, host db.[REF].supabase.co)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

# Runtime API: Transaction pooler (porta 6543) — trocar após migrations
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:6543/postgres

# --- Local (fallback se DATABASE_URL não estiver definida) ---
DB_HOST=localhost
DB_USER=postgres
DB_PASS=
DB_NAME=baggioappdb
DB_PORT=5432

# --- App ---
JWT_SECRET=
PPFY_USER=
PPFY_PASS=

# --- Seed admin ---
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=
