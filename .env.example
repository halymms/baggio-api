# --- Supabase ---
# Migrations/seed (local): Direct connection — IPv6, porta 5432
# DATABASE_DIRECT_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

# Runtime API (Railway): Shared Pooler IPv4 — Session (5432) ou Transaction (6543)
# Host deve ser aws-*.pooler.supabase.com (NÃO db.*.supabase.co)
# User no pooler: postgres.[PROJECT_REF]
# Senha com caracteres especiais: percent-encode (* → %2A)
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# --- Local (fallback se DATABASE_URL não estiver definida) ---
DB_HOST=localhost
DB_USER=postgres
DB_PASS=
DB_NAME=baggioappdb
DB_PORT=5432

# --- App ---
PORT=4000
JWT_SECRET=
PPFY_USER=
PPFY_PASS=
# Opcional: origens CORS separadas por vírgula (ex.: https://app.seudominio.com.br)
# FRONTEND_URL=

# --- Seed admin ---
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=
